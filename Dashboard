        f"Deribit expiry used: **{datetime.fromtimestamp(expiry_ts, timezone.utc).isoformat()}**  "
        f"· expiry minus Kalshi resolution: **{(expiry_ts - target_ts) / 86400:+.2f} days**"
    )
    st.caption(
        f"SSVI converged: {fit.success} · total-variance RMSE: "
        f"{np.sqrt(np.mean(fit.fun ** 2)):.6g}. Q is risk-neutral, not a forecast."
    )

    quoted_calls = [
        row for row in expiry_rows
        if row["option_type"] == "call"
        and row["bid"] is not None
        and row["ask"] is not None
    ]

    if quoted_calls:
        curve_strikes = np.linspace(
            min(row["strike"] for row in quoted_calls),
            max(row["strike"] for row in quoted_calls),
            300,
        )
    else:
        curve_strikes = np.linspace(threshold * 0.8, threshold * 1.2, 300)

    curve_prices = fitted_call_prices(
        curve_strikes, forward, years, float(theta[idx]),
        rho, gamma, eta, variance_fn,
    )

    call_curve_fig, call_curve_ax = plt.subplots(figsize=(10, 5))
    call_curve_ax.plot(
        curve_strikes, curve_prices,
        label="SSVI-fitted Black-76 call curve",
    )

    if quoted_calls:
        quote_strikes = np.array([row["strike"] for row in quoted_calls])
        quote_mids_usd = np.array([
            (row["bid"] + row["ask"]) * 0.5 * forward
            for row in quoted_calls
        ])
        call_curve_ax.scatter(
            quote_strikes, quote_mids_usd,
            s=18, alpha=0.65,
            label="Deribit call midquotes, converted from BTC",
        )

    call_curve_ax.axvline(
        threshold, color="red", linestyle="--",
        label=f"Threshold ${threshold:,.0f}",
    )
    call_curve_ax.set_xlabel("Strike K ($)")
    call_curve_ax.set_ylabel("Call price ($)")
    call_curve_ax.set_title("SSVI-fitted call-price curve")
    call_curve_ax.grid(True, alpha=0.3)
    call_curve_ax.legend()
    call_curve_fig.tight_layout()

    probability_tab, ssvi_tab, ev_tab = st.tabs(
        ["Probability estimate", "SSVI options graph", "Expected value"]
    )

    with probability_tab:
        st.metric("Raw BL Q(YES)", f"{q_yes:.6f}")
        st.caption(
            f"Forward: ${forward:,.2f} · "
            f"Threshold: ${threshold:,.2f}"
        )
        st.subheader("All boundaries in this Kalshi event")
        
        if boundary_rows:
            st.dataframe(
                boundary_rows,
                use_container_width=True,
                hide_index=True,
            )
        else:
            st.info("No boundary markets with usable YES prices were found.")        
        

    with ssvi_tab:
        st.pyplot(call_curve_fig, width="stretch")
        slopes = np.diff(curve_prices) / np.diff(curve_strikes)
        st.write("Fitted call-curve checks", {
            "slope range": (float(slopes.min()), float(slopes.max())),
            "non-increasing": bool(np.all(slopes <= 1e-5)),
            "convex": bool(np.all(np.diff(slopes) >= -1e-4)),
        })

    if not q_valid:
        st.error(
            f"BL produced an invalid probability ({q_yes:.8f}); "
            "the payoff screen is stopped."
        )
    

    calls = [
        row for row in expiry_rows
        if row["option_type"] == "call"
        and row["bid"] is not None
        and row["ask"] is not None
    ]

    ranked = []
    best = None

    if not q_valid:
        direction = None
    elif yes_ask is not None and q_yes > yes_ask:
        direction = "buy_yes_short_spread"
    elif yes_bid is not None and q_yes < yes_bid:
        direction = "buy_no_long_spread"
    else:
        direction = None

    # uses kalshi ask
    if yes_ask is not None and q_yes > yes_ask:
        direction = "buy_yes_short_spread"
    elif yes_bid is not None and q_yes < yes_bid:
        direction = "buy_no_long_spread"
    else:
        direction = None

    if direction is None:
        st.info(
            "No directional trade signal at executable YES prices: "
            "Q(YES) is inside or equal to the Kalshi YES bid/ask."
        )
    elif direction == "buy_no_long_spread" and no_ask is None:
        st.warning("Cannot evaluate this direction because the Kalshi NO ask is unavailable.")
        direction = None
    elif not calls:
        st.warning("No two-sided Deribit call quotes are available for this expiry.")
        direction = None

    if direction is not None:
        # Find quoted strikes on either side of the Kalshi threshold.
        pairs = [
            (long_call, short_call)
            for long_call in calls
            for short_call in calls
            if long_call["strike"] < threshold < short_call["strike"]
        ]

        for long_call, short_call in pairs:
            k1 = long_call["strike"]
            k2 = short_call["strike"]
            width_strike = k2 - k1
            spread_amount = 1.0 / width_strike

            if direction == "buy_yes_short_spread":
                option_cash = (
                    spread_amount
                    * (long_call["bid"] - short_call["ask"])
                    * forward
                )
                entry_cost = yes_ask - option_cash + fees_per_package
                trade_edge = option_cash - yes_ask - fees_per_package
            else:
                option_cash = (
                    spread_amount
                    * (long_call["ask"] - short_call["bid"])
                    * forward
                )
                entry_cost = no_ask + option_cash + fees_per_package
                trade_edge = 1.0 - entry_cost

            prices = np.unique(np.r_[
                np.linspace(k1 * 0.98, k2 * 1.02, 501),
                threshold,
                np.nextafter(threshold, np.inf),
                k1,
                k2,
            ])

            spread_payoff = spread_amount * (
                np.maximum(prices - k1, 0)
                - np.maximum(prices - k2, 0)
            )

            if direction == "buy_yes_short_spread":
                kalshi_payoff = (prices > threshold).astype(float)
                payoff = kalshi_payoff - spread_payoff
            else:
                kalshi_payoff = (prices <= threshold).astype(float)
                payoff = kalshi_payoff + spread_payoff

            profit = payoff - entry_cost

            ranked.append({
                "worst_case_profit": float(profit.min()),
                "entry_cost": entry_cost,
                "trade_edge": trade_edge,
                "long": long_call,
                "short": short_call,
                "prices": prices,
                "profit": profit,
                "direction": direction,
                "amount": spread_amount,
            })

        if not ranked:
            st.warning("No quoted call spread straddles the Kalshi threshold.")
        else:
            # Keep the spread with the best sampled worst-case result.
            positive_ranked = [
                item for item in ranked
                if item["trade_edge"] > 0
            ]

            if positive_ranked:
                ranked = positive_ranked

            ranked.sort(
                key=lambda item: item["trade_edge"],
                reverse=True,
            )
            best = ranked[0]
            if st.button(
                f"Load selected candidate ({int(contracts)} Kalshi contracts) "
                "into simulated trader",
                key="load_candidate_into_simulator",
            ):
                kalshi_outcome = (
                    "YES"
                    if best["direction"] == "buy_yes_short_spread"
                    else "NO"
                )
                kalshi_entry = yes_ask if kalshi_outcome == "YES" else no_ask

                if kalshi_entry is None:
                    st.error("The required Kalshi ask is unavailable.")
                else:
                    option_amount = int(contracts) * float(best["amount"])

                    if best["direction"] == "buy_yes_short_spread":
                        option_specs = [
                            (best["long"], "Short", best["long"]["bid"]),
                            (best["short"], "Long", best["short"]["ask"]),
                        ]
                    else:
                        option_specs = [
                            (best["long"], "Long", best["long"]["ask"]),
                            (best["short"], "Short", best["short"]["bid"]),
                        ]

                    suggested_positions = [{
                        "type": "Kalshi contract",
                        "contract": ticker,
                        "outcome": kalshi_outcome,
                        "side": "Long",
                        "quantity": int(contracts),
                        "avg_cost": float(kalshi_entry),
                        "manual_price": float(kalshi_entry),
                        "source": "strategy recommendation",
                    }]

                    for option, option_side, entry_btc in option_specs:
                        if entry_btc is None:
                            st.error(
                                f"An entry quote is missing for {option['name']}."
                            )
                            st.stop()

                        entry_usd_per_btc = float(entry_btc) * forward
                        suggested_positions.append({
                            "type": "Deribit option",
                            "contract": option["name"],
                            "outcome": None,
                            "side": option_side,
                            "quantity": option_amount,
                            "avg_cost": entry_usd_per_btc,
                            "manual_price": entry_usd_per_btc,
                            "source": "strategy recommendation",
                        })

                    # Replace the prior auto-loaded candidate while keeping
                    # any positions you entered manually.
                    st.session_state.simulated_positions = [
                        position
                        for position in st.session_state.simulated_positions
                        if position.get("source") != "strategy recommendation"
                    ] + suggested_positions

                    st.session_state.simulator_view = "workspace"
                    st.rerun()
            st.subheader("Directional paper screen")

            if direction == "buy_yes_short_spread":
                st.write(
                    f"**Candidate:** Buy Kalshi YES at ask "
                    f"{yes_ask:.4f}; sell **{best['long']['name']}** "
                    f"at bid {best['long']['bid']:.6f} BTC; buy "
                    f"**{best['short']['name']}** at ask "
                    f"{best['short']['ask']:.6f} BTC."
                )
            else:
                st.write(
                    f"**Candidate:** Buy Kalshi NO at ask "
                    f"{no_ask:.4f}; buy **{best['long']['name']}** "
                    f"at ask {best['long']['ask']:.6f} BTC; sell "
                    f"**{best['short']['name']}** at bid "
                    f"{best['short']['bid']:.6f} BTC."
                )

            st.write(
                f"Estimated executable edge outside the spread’s basis-risk "
                f"band: **${best['trade_edge']:.4f} per package**."
            )
            st.write(
                f"Sampled worst-case P/L: "
                f"**${best['worst_case_profit']:.4f} per package**."
            )

            if best["trade_edge"] > 0:
                st.success("The entered quotes show a positive paper-screen edge before settlement mismatch risk.")
            else:
                st.warning("The executable option quotes and fees do not leave a positive edge.")
    
    with ev_tab:
        if best is None:
            st.info("No quoted spread is available for an EV calculation.")
        else:
            model_calls = fitted_call_prices(
                [best["long"]["strike"], best["short"]["strike"]],
                forward,
                years,
                float(theta[idx]),
                rho,
                gamma,
                eta,
                variance_fn,
            )
            model_spread_value = best["amount"] * (
                model_calls[0] - model_calls[1]
            )

            if best["direction"] == "buy_yes_short_spread":
                expected_terminal_pnl = q_yes - model_spread_value
                spread_credit = best["amount"] * (
                    best["long"]["bid"] - best["short"]["ask"]
                ) * forward
                net_entry_pnl = (
                    spread_credit - yes_ask - fees_per_package
                )
                st.write(
                    f"1. Expected terminal P/L: Q(YES) "
                    f"{q_yes:.4f} − model spread value "
                    f"${model_spread_value:.4f} = "
                    f"${expected_terminal_pnl:.4f}"
                )
                st.write(
                    f"2. Net entry P/L: spread credit "
                    f"${spread_credit:.4f} − YES ask "
                    f"${yes_ask:.4f} − fees "
                    f"${fees_per_package:.4f} = "
                    f"${net_entry_pnl:.4f}"
                )
            else:
                expected_terminal_pnl = q_no + model_spread_value
                spread_debit = best["amount"] * (
                    best["long"]["ask"] - best["short"]["bid"]
                ) * forward
                net_entry_pnl = -(
                    no_ask + spread_debit + fees_per_package
                )
                st.write(
                    f"1. Expected terminal P/L: Q(NO) "
                    f"{q_no:.4f} + model spread value "
                    f"${model_spread_value:.4f} = "
                    f"${expected_terminal_pnl:.4f}"
                )
                st.write(
                    f"2. Net entry P/L: −NO ask "
                    f"${no_ask:.4f} − spread debit "
                    f"${spread_debit:.4f} − fees "
                    f"${fees_per_package:.4f} = "
                    f"${net_entry_pnl:.4f}"
                )

            ev_per_package = expected_terminal_pnl + net_entry_pnl
            st.write(
                f"3. SSVI risk-neutral EV: "
                f"${expected_terminal_pnl:.4f} + "
                f"${net_entry_pnl:.4f} = "
                f"**${ev_per_package:+.4f} per package**"
            )
            st.write(
                f"4. For {contracts} packages: "
                f"**${ev_per_package * contracts:+.4f}**"
            )
            st.caption(
                "This is an SSVI risk-neutral estimate, not real-world EV. "
                "It assumes a common settlement outcome and does not model "
                "the expiry mismatch."
            )       
    # Second existing graph: Kalshi-only outcome P/L and SSVI model value.
    labels, win_pnl, lose_pnl, model_values = [], [], [], []
    for name, ask, probability in (
        ("Buy YES", yes_ask, q_yes),
        ("Buy NO", no_ask, q_no),
    ):
        if ask is None:
            continue
        labels.append(name)
        win_pnl.append((1 - ask) * contracts)
        lose_pnl.append(-ask * contracts)
        model_values.append((probability - ask) * contracts)

    x = np.arange(len(labels))
    width = 0.25
    kalshi_fig, kalshi_ax = plt.subplots(figsize=(8, 4.5))
    kalshi_ax.bar(x - width, win_pnl, width, label="Contract wins")
    kalshi_ax.bar(x, lose_pnl, width, label="Contract loses")
    kalshi_ax.bar(x + width, model_values, width, label="SSVI model value")
    kalshi_ax.axhline(0, color="black", linewidth=0.8)
    kalshi_ax.set_xticks(x)
    kalshi_ax.set_xticklabels(labels)
    kalshi_ax.set_ylabel("P/L in dollars")
    kalshi_ax.set_title(f"Kalshi-only scenarios ({contracts} contracts)")
    kalshi_ax.legend()
    kalshi_ax.grid(axis="y", alpha=0.25)
    kalshi_fig.tight_layout()

    boundary_tab, kalshi_tab, ev_tab = st.tabs(
        ["Kalshi odds vs SSVI Q(YES)", "Kalshi-only scenarios", "Expected value"]
    )

    with boundary_tab:
        if not valid_boundary_rows:
            st.info("No valid SSVI boundary probabilities to plot.")
        else:
            fig, ax = plt.subplots(figsize=(8, 6))

            kalshi_x = [
                row["Kalshi P(YES)"] for row in valid_boundary_rows
            ]
            ssvi_y = [
                row["SSVI Q(YES)"] for row in valid_boundary_rows
            ]

            ax.scatter(kalshi_x, ssvi_y, alpha=0.8)

            for row in valid_boundary_rows:
                ax.annotate(
                    row["Boundary"],
                    (row["Kalshi P(YES)"], row["SSVI Q(YES)"]),
                    xytext=(5, 4),
                    textcoords="offset points",
                    fontsize=8,
                )

            ax.plot([0, 1], [0, 1], "--", color="gray", label="Q = Kalshi P")
            ax.set_xlim(0, 1)
            ax.set_ylim(0, 1)
            ax.set_aspect("equal", adjustable="box")
            ax.set_xlabel("Kalshi P(YES), using midpoint when available")
            ax.set_ylabel("SSVI Q(YES)")
            ax.set_title("Kalshi odds vs SSVI risk-neutral probability")
            ax.grid(True, alpha=0.3)
            ax.legend()
            fig.tight_layout()
            st.pyplot(fig, width="stretch")

    with kalshi_tab:
        st.pyplot(kalshi_fig, width="stretch")

    with ev_tab:
        if best is None:
            st.info("No quoted spread is available for an EV calculation.")
        else:
            model_calls = fitted_call_prices(
                [best["long"]["strike"], best["short"]["strike"]],
                forward,
                years,
                float(theta[idx]),
                rho,
                gamma,
                eta,
                variance_fn,
            )
            model_spread_value = best["amount"] * (
                model_calls[0] - model_calls[1]
            )

            if best["direction"] == "buy_yes_short_spread":
                expected_terminal_pnl = q_yes - model_spread_value
                net_entry_pnl = best["trade_edge"]
            else:
                expected_terminal_pnl = q_no + model_spread_value
                net_entry_pnl = -best["entry_cost"]

            ev_per_package = expected_terminal_pnl + net_entry_pnl

            st.metric(
                "SSVI risk-neutral EV per package",
                f"${ev_per_package:+.4f}",
            )
            st.metric(
                f"SSVI risk-neutral EV for {contracts} packages",
                f"${ev_per_package * contracts:+.4f}",
            )
            st.write({
                "Model call-spread value": float(model_spread_value),
                "Expected terminal P/L": float(expected_terminal_pnl),
                "Net entry P/L": float(net_entry_pnl),
            })
            st.caption(
                "This is an SSVI risk-neutral estimate. It assumes the legs "
                "share a settlement outcome and does not model the expiry mismatch."
            )

except requests.RequestException as exc:
    st.error(f"Network/API request failed: {exc}")
except (ValueError, RuntimeError, KeyError, TypeError) as exc:
    st.error(f"Could not complete comparison: {exc}")
