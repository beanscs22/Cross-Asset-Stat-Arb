try:
    resolution = datetime.fromisoformat(
        resolution_text.replace("Z", "+00:00")
    )
    if resolution.tzinfo is None:
        raise ValueError("Include a timezone, such as a trailing Z for UTC.")
    resolution = resolution.astimezone(timezone.utc)

    market = get_kalshi_market(ticker)
    yes_ask = read_kalshi_price(market, "yes_ask_dollars", "yes_ask")
    no_ask = read_kalshi_price(market, "no_ask_dollars", "no_ask")
    yes_bid = read_kalshi_price(market, "yes_bid_dollars", "yes_bid")
    no_bid = read_kalshi_price(market, "no_bid_dollars", "no_bid")
    if yes_ask is None and no_bid is not None:
        yes_ask = 1 - no_bid
    if no_ask is None and yes_bid is not None:
        no_ask = 1 - yes_bid

    rows = get_deribit_options()
    expiries, theta, rho, gamma, eta, variance_fn, fit = fit_ssvi(rows)
    target_ts = resolution.timestamp()
    idx = int(np.argmin(np.abs(expiries - target_ts)))
    expiry_ts = float(expiries[idx])
    expiry_rows = [row for row in rows if row["expiry_ts"] == expiry_ts]
    forward = float(np.median([row["forward"] for row in expiry_rows]))
    years = (expiry_ts - datetime.now(timezone.utc).timestamp()) / YEAR_SECONDS
    if years <= 0:
        raise RuntimeError("Selected Deribit expiry has passed.")

        
    #  Q(S_T > K) = -dC/dK
        # Breeden–Litzenberger estimate: Q(S_T > K) ≈ -dC/dK
    bump = max(threshold * 1e-4, 1.0)
    theta_used = float(theta[idx])

    phi_used = eta / (
        theta_used**gamma * (1.0 + theta_used)**(1.0 - gamma)
    )
    bound_1 = theta_used * phi_used * (1.0 + abs(rho))
    bound_2 = theta_used * phi_used**2 * (1.0 + abs(rho))

    c_lower = float(fitted_call_prices(
        [threshold - bump], forward, years, theta_used,
        rho, gamma, eta, variance_fn,
    )[0])
    c_upper = float(fitted_call_prices(
        [threshold + bump], forward, years, theta_used,
        rho, gamma, eta, variance_fn,
    )[0])

    q_yes = (c_lower - c_upper) / (2.0 * bump)
    q_no = 1.0 - q_yes
    q_valid = np.isfinite(q_yes) and 0.0 <= q_yes <= 1.0
    event_ticker = market.get("event_ticker")
    if event_ticker:
        event_markets = get_kalshi_event_markets(event_ticker)
    else:
        event_markets = [market]

    # Make sure the market entered in the sidebar is included.
    if not any(row.get("ticker") == ticker for row in event_markets):
        event_markets.append(market)

    option_strikes = [
        row["strike"] for row in expiry_rows
        if row["option_type"] == "call"
    ]
    min_option_strike = min(option_strikes) if option_strikes else None
    max_option_strike = max(option_strikes) if option_strikes else None

    boundary_rows = []

    for event_market in event_markets:
        parsed = market_boundary(event_market)
        if parsed is None:
            continue

        boundary_kind, boundary_label, lower_strike, upper_strike = parsed

        yes_bid_event = read_kalshi_price(
            event_market, "yes_bid_dollars", "yes_bid"
        )
        yes_ask_event = read_kalshi_price(
            event_market, "yes_ask_dollars", "yes_ask"
        )
        last_price = read_kalshi_price(
            event_market, "last_price_dollars", "last_price"
        )

        if yes_bid_event is not None and yes_ask_event is not None:
            kalshi_probability = (yes_bid_event + yes_ask_event) / 2
            price_source = "YES bid/ask midpoint"
        elif last_price is not None:
            kalshi_probability = last_price
            price_source = "last trade"
        elif yes_bid_event is not None:
            kalshi_probability = yes_bid_event
            price_source = "YES bid only"
        elif yes_ask_event is not None:
            kalshi_probability = yes_ask_event
            price_source = "YES ask only"
        else:
            continue

        if boundary_kind == "above":
            q_event = bl_q_above(
                lower_strike, forward, years, theta_used,
                rho, gamma, eta, variance_fn,
            )
        elif boundary_kind == "below":
            q_event = 1.0 - bl_q_above(
                upper_strike, forward, years, theta_used,
                rho, gamma, eta, variance_fn,
            )
        else:  # Between the lower and upper strike
            q_event = (
                bl_q_above(
                    lower_strike, forward, years, theta_used,
                    rho, gamma, eta, variance_fn,
                )
                - bl_q_above(
                    upper_strike, forward, years, theta_used,
                    rho, gamma, eta, variance_fn,
                )
            )

        boundary_strikes = [
            strike for strike in (lower_strike, upper_strike)
            if strike is not None
        ]
        within_option_range = (
            min_option_strike is not None
            and all(
                min_option_strike <= strike <= max_option_strike
                for strike in boundary_strikes
            )
        )
        probability_valid = (
            np.isfinite(q_event) and 0.0 <= q_event <= 1.0
        )

        boundary_rows.append({
            "Boundary": boundary_label,
            "Kalshi market": event_market.get("ticker", ""),
            "Kalshi P(YES)": kalshi_probability,
            "Kalshi price source": price_source,
            "SSVI Q(YES)": q_event,
            "Q − Kalshi P": q_event - kalshi_probability,
            "Valid probability": probability_valid,
            "Within option quote range": within_option_range,
        })

    boundary_rows.sort(
        key=lambda row: row["Kalshi P(YES)"]
    )
    valid_boundary_rows = [
        row for row in boundary_rows if row["Valid probability"]
    ]
    st.write("BL and SSVI diagnostics", {
        "C(K-bump)": c_lower,
        "C(K+bump)": c_upper,
        "bump": bump,
        "raw BL Q(YES)": q_yes,
