def get_json(url, params=None):
    response = requests.get(url, params=params, timeout=25)
    response.raise_for_status()
    data = response.json()
    if data.get("error"):
        raise RuntimeError(f"API error: {data['error']}")
    return data


def get_kalshi_market(ticker):
    data = get_json(f"{KALSHI_API}/markets/{ticker}")
    return data.get("market", data)

def get_kalshi_event_markets(event_ticker):
    markets = []
    cursor = None

    while True:
        params = {"event_ticker": event_ticker, "limit": 1000}
        if cursor:
            params["cursor"] = cursor

        payload = get_json(f"{KALSHI_API}/markets", params)
        markets.extend(payload.get("markets", []))
        cursor = payload.get("cursor")

        if not cursor:
            break

    return markets


def strike_number(value):
    if value is None:
        return None
    try:
        return float(value)
    except (TypeError, ValueError):
        cleaned = re.sub(r"[^0-9.\\-]", "", str(value))
        try:
            return float(cleaned)
        except ValueError:
            return None


def market_boundary(market_row):
    strike_type = (market_row.get("strike_type") or "").lower()
    floor = strike_number(market_row.get("floor_strike"))
    cap = strike_number(market_row.get("cap_strike"))

    ticker_match = re.search(
        r"-T(-?\\d+(?:\\.\\d+)?)$",
        market_row.get("ticker", ""),
    )
    ticker_strike = (
        float(ticker_match.group(1)) if ticker_match else None
    )

    if strike_type == "between" or (floor is not None and cap is not None):
        if floor is not None and cap is not None:
            return "between", f"${floor:,.0f}–${cap:,.0f}", floor, cap
        return None

    if strike_type.startswith("less"):
        strike = cap if cap is not None else floor
        if strike is None:
            strike = ticker_strike
        if strike is not None:
            return "below", f"< ${strike:,.0f}", None, strike
        return None

    if strike_type.startswith("greater"):
        strike = floor if floor is not None else cap
        if strike is None:
            strike = ticker_strike
        if strike is not None:
            return "above", f"> ${strike:,.0f}", strike, None
        return None

    strike = floor if floor is not None else cap
    if strike is None:
        strike = ticker_strike
    if strike is not None:
        return "above", f"> ${strike:,.0f}", strike, None

    return None


def bl_q_above(strike, forward, years, theta_value,
               rho, gamma, eta, variance_fn):
    """Estimate Q(S_T > strike) as -dC/dK from fitted call prices."""
    strike = float(strike)
    bump = min(max(strike * 1e-4, 1.0), strike * 0.49)

    calls = fitted_call_prices(
        [strike - bump, strike + bump],
        forward,
        years,
        theta_value,
        rho,
        gamma,
        eta,
        variance_fn,
    )
    return float((calls[0] - calls[1]) / (2.0 * bump))

def read_kalshi_price(market, dollars_field, cents_field):
    value = market.get(dollars_field)
    if value is not None:
        return float(value)
    value = market.get(cents_field)
    return float(value) / 100 if value is not None else None


def get_deribit_options():
    instrument_data = get_json(
        f"{DERIBIT_API}/public/get_instruments",
        {"currency": "BTC", "kind": "option", "expired": "false"},
    )
    instruments = {
        item["instrument_name"]: item
        for item in instrument_data.get("result", [])
    }

    summary_data = get_json(
        f"{DERIBIT_API}/public/get_book_summary_by_currency",
        {"currency": "BTC", "kind": "option"},
    )

    now = datetime.now(timezone.utc).timestamp()
    rows = []
    for quote in summary_data.get("result", []):
        instrument = instruments.get(quote.get("instrument_name"))
        if not instrument:
            continue
        try:
            expiry_ts = float(instrument["expiration_timestamp"]) / 1000
            years = (expiry_ts - now) / YEAR_SECONDS
            strike = float(instrument["strike"])
            iv = float(quote["mark_iv"]) / 100
            forward = float(quote["underlying_price"])
            if years <= 0 or strike <= 0 or iv <= 0 or forward <= 0:
                continue

            rows.append({
                "name": quote["instrument_name"],
                "option_type": instrument["option_type"],
                "expiry_ts": expiry_ts,
                "years": years,
                "strike": strike,
                "log_moneyness": math.log(strike / forward),
                "total_variance": iv * iv * years,
                "iv": iv,
                "forward": forward,
                "bid": quote.get("bid_price"),
                "ask": quote.get("ask_price"),
            })
        except (KeyError, TypeError, ValueError, ZeroDivisionError):
            continue

    if len(rows) < 10:
        raise RuntimeError(
            f"Only {len(rows)} usable Deribit option quotes found; need 10."
        )
    return rows


def fit_ssvi(rows):
    expiries = np.array(sorted({row["expiry_ts"] for row in rows}))
    expiry_idx = np.searchsorted(
        expiries, [row["expiry_ts"] for row in rows]
    )
    k = np.array([row["log_moneyness"] for row in rows])
    w = np.array([row["total_variance"] for row in rows])

    def unpack(params):
        rho = 0.999 * np.tanh(params[0])
        gamma = expit(params[1])

        # Positive, increasing ATM total variance across expiries.
        increments = np.exp(np.clip(params[3:3 + len(expiries)], -30, 10))
        theta = np.cumsum(increments)

        # Bound eta so the SSVI butterfly-arbitrage conditions hold.
        one_plus_abs_rho = 1.0 + abs(rho)

        a_values = (
            theta ** (1.0 - gamma)
            / (1.0 + theta) ** (1.0 - gamma)
        )
        b_values = (
            theta ** (1.0 - 2.0 * gamma)
            / (1.0 + theta) ** (2.0 - 2.0 * gamma)
        )

        eta_bound_a = 4.0 / (one_plus_abs_rho * np.max(a_values))
        eta_bound_b = np.sqrt(
            4.0 / (one_plus_abs_rho * np.max(b_values))
        )
        eta_max = min(eta_bound_a, eta_bound_b)

        # Strictly stay inside the first bound.
        eta = 0.999 * eta_max * expit(params[2])
        return rho, gamma, eta, theta

    def ssvi_variance(k_values, theta_values, rho, gamma, eta):
        phi = eta / (
            theta_values**gamma
            * (1.0 + theta_values)**(1.0 - gamma)
        )
        return 0.5 * theta_values * (
            1.0
            + rho * phi * k_values
            + np.sqrt((phi * k_values + rho)**2 + 1.0 - rho**2)
        )

    def residuals(params):
        rho, gamma, eta, theta = unpack(params)
        return (
            ssvi_variance(k, theta[expiry_idx], rho, gamma, eta) - w
        )

    initial = np.r_[
        np.arctanh(-0.3 / 0.999),
        0.0,
        0.0,
        np.log(np.full(len(expiries), 0.02)),
    ]

    result = least_squares(
        residuals,
        initial,
        max_nfev=20_000,
    )

    rho, gamma, eta, theta = unpack(result.x)
    return expiries, theta, rho, gamma, eta, ssvi_variance, result

def fitted_call_prices(strikes, forward, expiry_years, theta,
                       rho, gamma, eta, variance_fn):
    """Undiscounted Black-76 call prices using SSVI IV at each strike."""
    strikes = np.asarray(strikes, dtype=float)
    log_moneyness = np.log(strikes / forward)

    total_variance = np.asarray(variance_fn(
        log_moneyness,
        np.full_like(log_moneyness, theta),
        rho,
        gamma,
        eta,
    ), dtype=float)

    total_variance = np.maximum(total_variance, 1e-14)
    root_w = np.sqrt(total_variance)

    d1 = (np.log(forward / strikes) + 0.5 * total_variance) / root_w
    d2 = d1 - root_w

    return forward * ndtr(d1) - strikes * ndtr(d2)

